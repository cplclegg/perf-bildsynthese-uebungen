#version 450 core

struct Particle {
   vec3 position;
   vec3 velocity;
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer initial {
   Particle init[];
};

layout(set = 0, binding = 1) buffer current {
   Particle curr[];
};

void main(void)
{
  uint index = gl_GlobalInvocationID.x;
  
  // reset position after cube falls out of the bottom of the window
  if (curr[index].position.y < 0.0) {
    curr[index].position = init[index].position;
    curr[index].velocity = init[index].velocity;
  }

  // acceleration constant of 0.01 in downwards direction
  vec3 currAcceleration = vec3(0.0, -0.01, 0.0); 

  // simple euler integration
  curr[index].position += curr[index].velocity;
  curr[index].velocity += currAcceleration;
}
